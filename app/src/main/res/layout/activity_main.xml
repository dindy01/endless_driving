<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <com.endlessdrive.game.GameView
        android:id="@+id/gameView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/uiLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <ImageButton
            android:id="@+id/btnPause"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="@drawable/pause_bg"
            android:contentDescription="@string/pause"
            android:src="@drawable/ic_pause"
            android:visibility="gone" />

        <!-- Main menu -->
        <LinearLayout
            android:id="@+id/panelMenu"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:visibility="gone">

            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="0.7" />

            <TextView
                android:id="@+id/title1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.15"
                android:shadowColor="#AA000000"
                android:shadowDy="6"
                android:shadowRadius="12"
                android:text="@string/title_line1"
                android:textColor="@color/text"
                android:textSize="50sp" />

            <TextView
                android:id="@+id/title2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-14dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.35"
                android:shadowColor="#AA000000"
                android:shadowDy="6"
                android:shadowRadius="12"
                android:text="@string/title_line2"
                android:textColor="@color/accent"
                android:textSize="50sp" />

            <TextView
                android:id="@+id/txtMenuBest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#AA000000"
                android:shadowDy="3"
                android:shadowRadius="6"
                android:textColor="@color/gold"
                android:textSize="20sp" />

            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnPlay"
                style="@style/Btn"
                android:layout_height="68dp"
                android:text="@string/play"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btnSettings"
                style="@style/Btn.Secondary"
                android:text="@string/settings" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="36dp"
                android:shadowColor="#AA000000"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:text="@string/hint_controls"
                android:textColor="@color/text_dim"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Settings -->
        <LinearLayout
            android:id="@+id/panelSettings"
            style="@style/Panel">

            <TextView style="@style/PanelTitle" android:text="@string/settings" />

            <Button android:id="@+id/btnSound" style="@style/Btn.Secondary" />

            <Button android:id="@+id/btnVibration" style="@style/Btn.Secondary" />

            <Button android:id="@+id/btnPrivacyOptions" style="@style/Btn.Secondary"
                android:text="@string/privacy_options" android:visibility="gone" />

            <Button android:id="@+id/btnPrivacyPolicy" style="@style/Btn.Secondary"
                android:text="@string/privacy_policy" />

            <Button android:id="@+id/btnSettingsBack" style="@style/Btn" android:text="@string/back" />
        </LinearLayout>

        <!-- Pause -->
        <LinearLayout
            android:id="@+id/panelPause"
            style="@style/Panel">

            <TextView style="@style/PanelTitle" android:text="@string/paused" />

            <Button android:id="@+id/btnResume" style="@style/Btn" android:text="@string/resume" />

            <Button android:id="@+id/btnPauseMenu" style="@style/Btn.Secondary" android:text="@string/menu" />
        </LinearLayout>

        <!-- Game over -->
        <LinearLayout
            android:id="@+id/panelGameOver"
            style="@style/Panel">

            <TextView style="@style/PanelTitle" android:text="@string/crashed" android:textColor="@color/accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/score"
                android:textAllCaps="true"
                android:textColor="@color/text_dim"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/text"
                android:textSize="48sp" />

            <TextView
                android:id="@+id/txtNewBest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="@string/new_best"
                android:textAllCaps="true"
                android:textColor="@color/gold"
                android:textSize="18sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtBest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/gold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txtRunStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />

            <Button android:id="@+id/btnContinue" style="@style/Btn.Reward"
                android:layout_marginTop="16dp" android:text="@string/continue_ad" android:visibility="gone" />

            <Button android:id="@+id/btnRetry" style="@style/Btn" android:text="@string/retry" />

            <Button android:id="@+id/btnGameOverMenu" style="@style/Btn.Secondary" android:text="@string/menu" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
